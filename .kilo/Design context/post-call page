<!-- Interactive Scripts for audio toggle and copy feedback -->
<script>
  document.addEventListener('DOMContentLoaded', () => {
    const playBtn = document.getElementById('mainPlayBtn');
    let isPlaying = false;
    
    playBtn.addEventListener('click', () => {
      isPlaying = !isPlaying;
      const icon = playBtn.querySelector('.material-symbols-outlined');
      if (isPlaying) {
        icon.textContent = 'pause';
      } else {
        icon.textContent = 'play_arrow';
      }
    });

    const copyBtn = document.getElementById('copySummaryBtn');
    copyBtn.addEventListener('click', () => {
      const originalContent = copyBtn.innerHTML;
      copyBtn.innerHTML = `
        <span class="material-symbols-outlined text-[16px] text-[#ebe1c1]">check_circle</span>
        <span class="text-[#ebe1c1]">Summary Copied</span>
      `;
      setTimeout(() => {
        copyBtn.innerHTML = originalContent;
      }, 2000);
    });

    // Waveform seek update
    const waveform = document.getElementById('waveformContainer');
    waveform.addEventListener('click', (e) => {
      const rect = waveform.getBoundingClientRect();
      const clickX = e.clientX - rect.left;
      const width = rect.width;
      const percentage = Math.max(0, Math.min(100, (clickX / width) * 100));
      
      const scrubLine = waveform.querySelector('.absolute');
      if (scrubLine) {
        scrubLine.style.left = `${percentage}%`;
      }

      const totalSeconds = 12 * 60 + 45;
      const currentSec = Math.floor((percentage / 100) * totalSeconds);
      const mins = String(Math.floor(currentSec / 60)).padStart(2, '0');
      const secs = String(currentSec % 60).padStart(2, '0');
      const timeDisplay = document.getElementById('currentTimeDisplay');
      if (timeDisplay) {
        timeDisplay.textContent = `${mins}:${secs}`;
      }
    });
  });
</script>


