<footer class="h-20 border-t border-outline-variant/70 bg-surface-container-lowest px-8 flex items-center justify-between shrink-0 z-30">
<!-- Left: Quiet Audio Indicator -->
<div class="hidden lg:flex items-center space-x-3 text-xs text-on-surface-variant w-52">
<div class="w-8 h-8 rounded-full bg-surface-container flex items-center justify-center text-primary">
<span class="material-symbols-outlined text-[17px]" data-icon="graphic_eq">graphic_eq</span>
</div>
<div>
<p class="font-medium text-primary">Spatial Voice Audio</p>
<p class="text-[11px] text-outline">Clear &amp; Natural</p>
</div>
</div>
<!-- Center: Fallback Text / Notes Bar -->
<div class="flex-1 max-w-xl mx-4">
<div class="flex items-center bg-surface-container-low hover:bg-surface-container/60 border border-outline-variant rounded-full px-4 py-2 focus-within:border-primary focus-within:bg-white focus-within:ring-1 focus-within:ring-primary/20 transition-all shadow-sm">
<input class="flex-1 bg-transparent border-0 focus:ring-0 text-sm text-primary placeholder:text-outline/70 p-0 focus:outline-none" placeholder="Type a message or note for Aura..." type="text">
<button class="ml-2 w-7 h-7 rounded-full bg-primary hover:bg-[#082a32] text-white flex items-center justify-center transition-colors shadow-sm" title="Send note" style="background-color: var(--ink-black, #03191e);">
<span class="material-symbols-outlined text-[15px]" data-icon="arrow_upward">arrow_upward</span>
</button>
</div>
</div>
<!-- Right: Clean Call Actions -->
<div class="flex items-center space-x-3">
<!-- Mute Mic Toggle -->
<button class="w-10 h-10 rounded-full bg-surface-container hover:bg-surface-container-high text-primary flex items-center justify-center transition-colors" id="dockMicToggle" title="Mute Microphone">

</button>
<!-- Pause Session -->

<!-- End Call Button (Understated refined crimson) -->
<button class="h-10 px-5 rounded-full bg-[#9c2f2f] hover:bg-[#862525] text-white flex items-center space-x-2 transition-all shadow-sm active:scale-95">
<span class="material-symbols-outlined text-[18px]" data-icon="call_end">call_end</span>
<span class="text-xs font-semibold tracking-wide">End Call</span>
</button>
</div>
</footer>
<!-- Interactive micro-script -->
<script>
  const micButton = document.getElementById('mainMicBtn');
  const dockMicToggle = document.getElementById('dockMicToggle');
  let isMuted = false;

  function toggleMute() {
    isMuted = !isMuted;
    const centerIcon = micButton.querySelector('span');
    const dockIcon = dockMicToggle.querySelector('span');

    if (isMuted) {
      centerIcon.textContent = 'mic_off';
      dockIcon.textContent = 'mic_off';
      micButton.classList.remove('bg-primary');
      micButton.classList.add('bg-error');
      dockMicToggle.classList.add('text-error');
    } else {
      centerIcon.textContent = 'mic';
      dockIcon.textContent = 'mic';
      micButton.classList.add('bg-primary');
      micButton.classList.remove('bg-error');
      dockMicToggle.classList.remove('text-error');
    }
  }

  micButton.addEventListener('click', toggleMute);
  dockMicToggle.addEventListener('click', toggleMute);

  // Spacebar shortcut
  window.addEventListener('keydown', (e) => {
    if (e.code === 'Space' && e.target.tagName !== 'INPUT') {
      e.preventDefault();
      toggleMute();
    }
  });
</script>


</body></html>